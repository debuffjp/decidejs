{
  "name": "decidekit",
  "version": "0.2.2",
  "description": "A System One model in the browser: typed, calibrated text decisions on the user's device. Learns from an LLM when it isn't sure.",
  "license": "MIT",
  "repository": "github:debuffjp/decidekit",
  "keywords": [
    "decision model",
    "system one",
    "classification",
    "intent",
    "zero-shot",
    "calibration",
    "llm",
    "embeddings",
    "browser",
    "typescript",
    "text classification",
    "transformers.js",
    "on-device",
    "llm fallback"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./switch": {
      "types": "./dist/switch.d.ts",
      "default": "./dist/switch.js"
    },
    "./typesafe": {
      "types": "./dist/typesafe.d.ts",
      "default": "./dist/typesafe.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "eval": "node --experimental-strip-types eval/banking77.ts",
    "bench": "esbuild src/worker.ts src/browser.ts --bundle --format=esm --platform=browser --outdir=bench --alias:onnxruntime-web/webgpu=onnxruntime-web/wasm && node bench/serve.mjs",
    "playground": "node playground/build.mjs",
    "heads": "node --experimental-strip-types heads/build.ts",
    "bench:run": "node bench/run.mjs",
    "eval:suite": "node --experimental-strip-types eval/suite.ts",
    "eval:hill": "node --experimental-strip-types eval/hill.ts",
    "test": "node --test --experimental-strip-types \"test/*.test.ts\"",
    "lint:prose": "node scripts/lint-prose.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.3.0",
    "esbuild": "0.25.10",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "spryte": "0.11.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  },
  "homepage": "https://debuff.jp/decide/",
  "bugs": "https://github.com/debuffjp/decidekit/issues",
  "bin": {
    "decidekit": "./dist/cli.js"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
