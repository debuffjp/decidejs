{
  "name": "decidejs",
  "version": "0.1.0",
  "description": "Typed, calibrated decisions in the browser or Node. Your options are the type; no server, no API key.",
  "license": "MIT",
  "repository": "github:debuffjp/decidejs",
  "keywords": [
    "classification",
    "intent",
    "zero-shot",
    "embeddings",
    "browser",
    "typescript",
    "system one"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "eval": "node --experimental-strip-types eval/banking77.ts",
    "bench": "esbuild src/worker.ts src/browser.ts --bundle --format=esm --platform=browser --outdir=bench --alias:onnxruntime-web/webgpu=onnxruntime-web/wasm && node bench/serve.mjs",
    "playground": "node playground/build.mjs",
    "heads": "node --experimental-strip-types heads/build.ts",
    "bench:run": "node bench/run.mjs",
    "eval:suite": "node --experimental-strip-types eval/suite.ts",
    "eval:hill": "node --experimental-strip-types eval/hill.ts",
    "test": "node --test --experimental-strip-types \"test/*.test.ts\"",
    "lint:prose": "node scripts/lint-prose.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.3.0",
    "esbuild": "0.25.10",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "spryte": "0.11.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  },
  "homepage": "https://github.com/debuffjp/decidejs#readme",
  "bugs": "https://github.com/debuffjp/decidejs/issues",
  "bin": {
    "decidejs": "./dist/cli.js"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
